324	    protected RealPointValuePair getSolution() {
325	        double[] coefficients = new double[getOriginalNumDecisionVariables()];
326	        Integer basicRow =
327	            getBasicRow(getNumObjectiveFunctions() + getOriginalNumDecisionVariables());
