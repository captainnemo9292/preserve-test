147	                // need to scale
148	                if (a != 0.0) {
149	                    p2 = p1 + (b / a * p0);
150	                    q2 = q1 + (b / a * q0);
151	                } else if (b != 0) {
152	                    p2 = (a / b * p1) + p0;
153	                    q2 = (a / b * q1) + q0;
154	                } else {
155	                    // can not scale an convergent is unbounded.
156	                    throw new ConvergenceException(
157	                        "Continued fraction convergents diverged to +/- infinity for value {0}",
