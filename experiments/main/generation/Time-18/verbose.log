                && month == 2 && day == 29;

        assumeTrue(validIf);
        assumeTrue(buggyIf);

        String exc = "none";
        int gotYear = -1, gotMonth = -1, gotDay = -1;
        try {
            DateTime dt = new DateTime(year, month, day, 0, 0, 0, 0, GJChronology.getInstanceUTC());
            gotYear = dt.getYear();
            gotMonth = dt.getMonthOfYear();
            gotDay = dt.getDayOfMonth();
        } catch (Exception e) {
