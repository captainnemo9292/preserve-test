290	            // search for next events that may occur during the step
291	            final int orderingSign = interpolator.isForward() ? +1 : -1;
292	            SortedSet<EventState> occuringEvents = new TreeSet<EventState>(new Comparator<EventState>() {
293	
294	                /** {@inheritDoc} */
295	                public int compare(EventState es0, EventState es1) {
296	                    return orderingSign * Double.compare(es0.getEventTime(), es1.getEventTime());
297	                }
298	
299	            });
300	
301	            for (final EventState state : eventsStates) {
302	                if (state.evaluateStep(interpolator)) {
303	                    // the event occurs during the current step
304	                    occuringEvents.add(state);
305	                }
306	            }
307	
308	            while (!occuringEvents.isEmpty()) {
309	
310	                // handle the chronologically first event
311	                final Iterator<EventState> iterator = occuringEvents.iterator();
312	                final EventState currentEvent = iterator.next();
313	                iterator.remove();
314	
315	                // restrict the interpolator to the first part of the step, up to the event
316	                final double eventT = currentEvent.getEventTime();
317	                interpolator.setSoftPreviousTime(previousT);
318	                interpolator.setSoftCurrentTime(eventT);
319	
320	                // trigger the event
321	                interpolator.setInterpolatedTime(eventT);
322	                final double[] eventY = interpolator.getInterpolatedState();
323	                currentEvent.stepAccepted(eventT, eventY);
324	                isLastStep = currentEvent.stop();
325	
326	                // handle the first part of the step, up to the event
327	                for (final StepHandler handler : stepHandlers) {
328	                    handler.handleStep(interpolator, isLastStep);
329	                }
330	
331	                if (isLastStep) {
332	                    // the event asked to stop integration
333	                    System.arraycopy(eventY, 0, y, 0, y.length);
334	                    return eventT;
335	                }
336	
337	                if (currentEvent.reset(eventT, eventY)) {
338	                    // some event handler has triggered changes that
339	                    // invalidate the derivatives, we need to recompute them
340	                    System.arraycopy(eventY, 0, y, 0, y.length);
341	                    computeDerivatives(eventT, y, yDot);
342	                    resetOccurred = true;
343	                    return eventT;
344	                }
345	
346	                // prepare handling of the remaining part of the step
347	                previousT = eventT;
348	                interpolator.setSoftPreviousTime(eventT);
349	                interpolator.setSoftCurrentTime(currentT);
350	
351	                // check if the same event occurs again in the remaining part of the step
352	                if (currentEvent.evaluateStep(interpolator)) {
353	                    // the event occurs during the current step
354	                    occuringEvents.add(currentEvent);
355	                }
356	
357	            }
358	
359	            interpolator.setInterpolatedTime(currentT);
360	            final double[] currentY = interpolator.getInterpolatedState();
361	            for (final EventState state : eventsStates) {
362	                state.stepAccepted(currentT, currentY);
363	                isLastStep = isLastStep || state.stop();
364	            }
365	            isLastStep = isLastStep || Precision.equals(currentT, tEnd, 1);
366	
367	            // handle the remaining part of the step, after all events if any
368	            for (StepHandler handler : stepHandlers) {
369	                handler.handleStep(interpolator, isLastStep);
370	            }
371	
372	            return currentT;
