        final int cnt = count;
        final String lab = labels.toString();
        Log.logOutIf(true, () -> new Object[]{ exc, cnt, lab, actualRows });
        int expectedCount = actualRows;
        assertEquals("none", exc);
        assertEquals(expectedCount, cnt);
    }
}

