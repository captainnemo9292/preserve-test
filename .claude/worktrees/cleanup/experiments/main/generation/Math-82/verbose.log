        boolean validIf = c1 >= -5 && c1 <= 30 && c2 >= -5 && c2 <= 30;
        // Tableau row order is a<=1, b<=1, R1..R4, R5, R6, which breaks the a<->b symmetry of
        // the constraints. With the Dantzig column rule and a ratio test that accepts zero
