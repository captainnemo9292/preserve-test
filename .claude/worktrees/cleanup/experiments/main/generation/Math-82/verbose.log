290	    private Integer getBasicRow(final int col, boolean ignoreObjectiveRows) {
291	        Integer row = null;
292	        int start = ignoreObjectiveRows ? getNumObjectiveFunctions() : 0;
293	        for (int i = start; i < getHeight(); i++) {
294	            if (MathUtils.equals(getEntry(i, col), 1.0, epsilon) && (row == null)) {
295	                row = i;
296	            } else if (!MathUtils.equals(getEntry(i, col), 0.0, epsilon)) {
297	                return null;
298	            }
299	        }
300	        return row;
301	    }
