141	    /**
142	     * Returns whether the problem is at an optimal state.
143	     * @param tableau simple tableau for the problem
144	     * @return whether the model has been solved
145	     */
146	    public boolean isOptimal(final SimplexTableau tableau) {
147	        if (tableau.getNumArtificialVariables() > 0) {
148	            return false;
149	        }
150	        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
151	            if (MathUtils.compareTo(tableau.getEntry(0, i), 0, epsilon) < 0) {
152	                return false;
153	            }
154	        }
155	        return true;
156	    }
157	
158	    /**
159	     * Solves Phase 1 of the Simplex method.
160	     * @param tableau simple tableau for the problem
161	     * @exception OptimizationException if the maximal number of iterations is
162	     * exceeded, or if the problem is found not to have a bounded solution, or
163	     * if there is no feasible solution
164	     */
165	    protected void solvePhase1(final SimplexTableau tableau)
166	        throws OptimizationException {
167	        // make sure we're in Phase 1
168	        if (tableau.getNumArtificialVariables() == 0) {
169	            return;
170	        }
171	
172	        while (!isPhase1Solved(tableau)) {
173	            doIteration(tableau);
174	        }
175	
176	        // if W is not zero then we have no feasible solution
177	        if (!MathUtils.equals(tableau.getEntry(0, tableau.getRhsOffset()), 0, epsilon)) {
178	            throw new NoFeasibleSolutionException();
179	        }
180	    }
181	
182	    /** {@inheritDoc} */
183	    @Override
184	    public RealPointValuePair doOptimize()
185	        throws OptimizationException {
186	        final SimplexTableau tableau =
187	            new SimplexTableau(f, constraints, goalType, restrictToNonNegative, epsilon);
188	        solvePhase1(tableau);
189	        tableau.discardArtificialVariables();
190	        while (!isOptimal(tableau)) {
191	            doIteration(tableau);
192	        }
193	        return tableau.getSolution();
194	    }
