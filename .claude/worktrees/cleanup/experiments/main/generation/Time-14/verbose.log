        public MonthGen() { super(Integer.class); }
        @Override public Integer generate(SourceOfRandomness r, GenerationStatus status) {
            if (r.nextInt(10) < 6) {
                return 2;
            }
            return r.nextInt(1, 12);
        }
    }

    public static class DayGen extends Generator<Integer> {
