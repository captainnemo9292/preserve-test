219	    private double solve(final UnivariateRealFunction f,
220	                         double x0, double y0,
221	                         double x1, double y1,
222	                         double x2, double y2)
223	    throws MaxIterationsExceededException, FunctionEvaluationException {
224	
225	        double delta = x1 - x0;
226	        double oldDelta = delta;
227	
228	        int i = 0;
229	        while (i < maximalIterationCount) {
230	            if (Math.abs(y2) < Math.abs(y1)) {
231	                // use the bracket point if is better than last approximation
232	                x0 = x1;
233	                x1 = x2;
234	                x2 = x0;
235	                y0 = y1;
236	                y1 = y2;
237	                y2 = y0;
238	            }
239	            if (Math.abs(y1) <= functionValueAccuracy) {
240	                // Avoid division by very small values. Assume
241	                // the iteration has converged (the problem may
242	                // still be ill conditioned)
243	                setResult(x1, i);
244	                return result;
245	            }
246	            double dx = x2 - x1;
247	            double tolerance =
248	                Math.max(relativeAccuracy * Math.abs(x1), absoluteAccuracy);
249	            if (Math.abs(dx) <= tolerance) {
250	                setResult(x1, i);
251	                return result;
252	            }
253	            if ((Math.abs(oldDelta) < tolerance) ||
254	                    (Math.abs(y0) <= Math.abs(y1))) {
255	                // Force bisection.
256	                delta = 0.5 * dx;
257	                oldDelta = delta;
258	            } else {
259	                double r3 = y1 / y0;
260	                double p;
261	                double p1;
262	                // the equality test (x0 == x2) is intentional,
263	                // it is part of the original Brent's method,
264	                // it should NOT be replaced by proximity test
265	                if (x0 == x2) {
266	                    // Linear interpolation.
267	                    p = dx * r3;
268	                    p1 = 1.0 - r3;
269	                } else {
270	                    // Inverse quadratic interpolation.
271	                    double r1 = y0 / y2;
272	                    double r2 = y1 / y2;
273	                    p = r3 * (dx * r1 * (r1 - r2) - (x1 - x0) * (r2 - 1.0));
274	                    p1 = (r1 - 1.0) * (r2 - 1.0) * (r3 - 1.0);
275	                }
276	                if (p > 0.0) {
277	                    p1 = -p1;
278	                } else {
279	                    p = -p;
280	                }
