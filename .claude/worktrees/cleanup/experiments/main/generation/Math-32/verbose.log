330	    /** Get the intersection point of three planes.
331	     * @param plane1 first plane1
332	     * @param plane2 second plane2
333	     * @param plane3 third plane2
334	     * @return intersection point of three planes, null if some planes are parallel
335	     */
336	    public static Vector3D intersection(final Plane plane1, final Plane plane2, final Plane plane3) {
337	
338	        // coefficients of the three planes linear equations
339	        final double a1 = plane1.w.getX();
340	        final double b1 = plane1.w.getY();
341	        final double c1 = plane1.w.getZ();
342	        final double d1 = plane1.originOffset;
343	
344	        final double a2 = plane2.w.getX();
345	        final double b2 = plane2.w.getY();
346	        final double c2 = plane2.w.getZ();
347	        final double d2 = plane2.originOffset;
348	
349	        final double a3 = plane3.w.getX();
350	        final double b3 = plane3.w.getY();
351	        final double c3 = plane3.w.getZ();
352	        final double d3 = plane3.originOffset;
353	
354	        // direct Cramer resolution of the linear system
355	        // (this is still feasible for a 3x3 system)
356	        final double a23         = b2 * c3 - b3 * c2;
357	        final double b23         = c2 * a3 - c3 * a2;
358	        final double c23         = a2 * b3 - a3 * b2;
359	        final double determinant = a1 * a23 + b1 * b23 + c1 * c23;
360	        if (FastMath.abs(determinant) < 1.0e-10) {
361	            return null;
362	        }
363	
364	        final double r = 1.0 / determinant;
365	        return new Vector3D(
366	                            (-a23 * d1 - (c1 * b3 - c3 * b1) * d2 - (c2 * b1 - c1 * b2) * d3) * r,
367	                            (-b23 * d1 - (c3 * a1 - c1 * a3) * d2 - (c1 * a2 - c2 * a1) * d3) * r,
368	                            (-c23 * d1 - (b1 * a3 - b3 * a1) * d2 - (b2 * a1 - b1 * a2) * d3) * r);
369	
370	    }
