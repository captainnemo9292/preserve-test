                    if (attr.getPlusOutside() != null) {
                        count[0]++;
                    }
                    if (attr.getPlusInside() != null) {
                        count[0]++;
                    }
                }
                public void visitLeafNode(BSPTree<Euclidean3D> node) {
                }
