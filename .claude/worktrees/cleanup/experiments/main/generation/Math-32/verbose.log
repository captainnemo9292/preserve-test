            -1.0f, -1.0f,  1.0f,
            -1.0f, -1.0f, -1.0f,
             1.0f,  1.0f, V4Z[pertA],
            V5X[pertB], 1.0f,  1.0f,
            -1.0f,  1.0f,  1.0f,
            -1.0f,  1.0f, -1.0f
        };
        int[] indices = {
            0, 1, 2,  2, 3, 0,  4, 7, 6,  6, 5, 4,
            0, 4, 5,  5, 1, 0,  1, 5, 6,  6, 2, 1,
            2, 6, 7,  7, 3, 2,  4, 0, 3,  3, 7, 4
        };

