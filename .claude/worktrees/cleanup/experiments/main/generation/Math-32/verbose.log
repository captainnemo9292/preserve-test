286	    /** Follow a boundary loop.
287	     * @param node node containing the segment starting the loop
288	     * @param sorted set of segments belonging to the boundary, sorted by
289	     * start points (contains {@code node})
290	     * @return a list of connected sub-hyperplanes starting at
291	     * {@code node}
292	     */
293	    private List<ComparableSegment> followLoop(final AVLTree<ComparableSegment>.Node node,
294	                                               final AVLTree<ComparableSegment> sorted) {
295	
296	        final ArrayList<ComparableSegment> loop = new ArrayList<ComparableSegment>();
297	        ComparableSegment segment = node.getElement();
298	        loop.add(segment);
299	        final Vector2D globalStart = segment.getStart();
300	        Vector2D end = segment.getEnd();
301	        node.delete();
302	
303	        // is this an open or a closed loop ?
304	        final boolean open = segment.getStart() == null;
305	
306	        while ((end != null) && (open || (globalStart.distance(end) > 1.0e-10))) {
307	
308	            // search the sub-hyperplane starting where the previous one ended
309	            AVLTree<ComparableSegment>.Node selectedNode = null;
310	            ComparableSegment       selectedSegment  = null;
311	            double                  selectedDistance = Double.POSITIVE_INFINITY;
312	            final ComparableSegment lowerLeft        = new ComparableSegment(end, -1.0e-10, -1.0e-10);
313	            final ComparableSegment upperRight       = new ComparableSegment(end, +1.0e-10, +1.0e-10);
314	            for (AVLTree<ComparableSegment>.Node n = sorted.getNotSmaller(lowerLeft);
315	                 (n != null) && (n.getElement().compareTo(upperRight) <= 0);
316	                 n = n.getNext()) {
317	                segment = n.getElement();
318	                final double distance = end.distance(segment.getStart());
319	                if (distance < selectedDistance) {
320	                    selectedNode     = n;
321	                    selectedSegment  = segment;
322	                    selectedDistance = distance;
323	                }
324	            }
325	
326	            if (selectedDistance > 1.0e-10) {
327	                // this is a degenerated loop, it probably comes from a very
328	                // tiny region with some segments smaller than the threshold, we
329	                // simply ignore it
330	                return null;
331	            }
332	
333	            end = selectedSegment.getEnd();
334	            loop.add(selectedSegment);
335	            selectedNode.delete();
336	
337	        }
338	
339	        if ((loop.size() == 2) && !open) {
340	            // this is a degenerated infinitely thin loop, we simply ignore it
341	            return null;
342	        }
343	
344	        if ((end == null) && !open) {
345	            throw new MathInternalError();
346	        }
347	
348	        return loop;
349	
350	    }
