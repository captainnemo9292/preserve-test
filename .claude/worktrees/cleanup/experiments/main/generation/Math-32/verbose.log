208	            if (getTree(false).getCut() == null) {
209	                vertices = new Vector2D[0][];
210	            } else {
211	
212	                // sort the segments according to their start point
213	                final SegmentsBuilder visitor = new SegmentsBuilder();
214	                getTree(true).visit(visitor);
215	                final AVLTree<ComparableSegment> sorted = visitor.getSorted();
216	
217	                // identify the loops, starting from the open ones
218	                // (their start segments are naturally at the sorted set beginning)
219	                final ArrayList<List<ComparableSegment>> loops = new ArrayList<List<ComparableSegment>>();
220	                while (!sorted.isEmpty()) {
221	                    final AVLTree<ComparableSegment>.Node node = sorted.getSmallest();
222	                    final List<ComparableSegment> loop = followLoop(node, sorted);
223	                    if (loop != null) {
224	                        loops.add(loop);
225	                    }
226	                }
227	
228	                // tranform the loops in an array of arrays of points
229	                vertices = new Vector2D[loops.size()][];
230	                int i = 0;
231	
232	                for (final List<ComparableSegment> loop : loops) {
233	                    if (loop.size() < 2) {
234	                        // single infinite line
235	                        final Line line = loop.get(0).getLine();
236	                        vertices[i++] = new Vector2D[] {
237	                            null,
238	                            line.toSpace(new Vector1D(-Float.MAX_VALUE)),
239	                            line.toSpace(new Vector1D(+Float.MAX_VALUE))
240	                        };
241	                    } else if (loop.get(0).getStart() == null) {
242	                        // open loop with at least one real point
243	                        final Vector2D[] array = new Vector2D[loop.size() + 2];
244	                        int j = 0;
245	                        for (Segment segment : loop) {
246	
247	                            if (j == 0) {
