129	    @Override
130	    protected void computeGeometricalProperties() {
131	
132	        final Vector2D[][] v = getVertices();
133	
134	        if (v.length == 0) {
135	            final BSPTree<Euclidean2D> tree = getTree(false);
136	            if ((Boolean) tree.getAttribute()) {
137	                // the instance covers the whole space
138	                setSize(Double.POSITIVE_INFINITY);
139	                setBarycenter(Vector2D.NaN);
140	            } else {
141	                setSize(0);
142	                setBarycenter(new Vector2D(0, 0));
143	            }
144	        } else if (v[0][0] == null) {
145	            // there is at least one open-loop: the polygon is infinite
146	            setSize(Double.POSITIVE_INFINITY);
147	            setBarycenter(Vector2D.NaN);
148	        } else {
149	            // all loops are closed, we compute some integrals around the shape
150	
151	            double sum  = 0;
152	            double sumX = 0;
153	            double sumY = 0;
154	
155	            for (Vector2D[] loop : v) {
156	                double x1 = loop[loop.length - 1].getX();
157	                double y1 = loop[loop.length - 1].getY();
158	                for (final Vector2D point : loop) {
159	                    final double x0 = x1;
160	                    final double y0 = y1;
161	                    x1 = point.getX();
162	                    y1 = point.getY();
163	                    final double factor = x0 * y1 - y0 * x1;
164	                    sum  += factor;
165	                    sumX += factor * (x0 + x1);
166	                    sumY += factor * (y0 + y1);
167	                }
168	            }
169	
170	            if (sum < 0) {
171	                // the polygon as a finite outside surrounded by an infinite inside
172	                setSize(Double.POSITIVE_INFINITY);
173	                setBarycenter(Vector2D.NaN);
174	            } else {
175	                setSize(sum / 2);
176	                setBarycenter(new Vector2D(sumX / (3 * sum), sumY / (3 * sum)));
177	            }
178	
179	        }
180	
181	    }
