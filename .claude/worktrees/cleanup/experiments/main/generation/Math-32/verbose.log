302	     * @return intersection point between between the line and the
303	     * instance (null if the line is parallel to the instance)
304	     */
305	    public Vector3D intersection(final Line line) {
306	        final Vector3D direction = line.getDirection();
307	        final double   dot       = w.dotProduct(direction);
308	        if (FastMath.abs(dot) < 1.0e-10) {
309	            return null;
310	        }
311	        final Vector3D point = line.toSpace(Vector1D.ZERO);
312	        final double   k     = -(originOffset + w.dotProduct(point)) / dot;
313	        return new Vector3D(1.0, point, k, direction);
314	    }
