316	    /** Build the line shared by the instance and another plane.
317	     * @param other other plane
318	     * @return line at the intersection of the instance and the
319	     * other plane (really a {@link Line Line} instance)
320	     */
321	    public Line intersection(final Plane other) {
322	        final Vector3D direction = Vector3D.crossProduct(w, other.w);
323	        if (direction.getNorm() < 1.0e-10) {
324	            return null;
325	        }
326	        final Vector3D point = intersection(this, other, new Plane(direction));
327	        return new Line(point, point.add(direction));
328	    }
