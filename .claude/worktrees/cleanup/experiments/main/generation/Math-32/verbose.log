54	    public Side side(Hyperplane<Euclidean3D> hyperplane) {
55	
56	        final Plane otherPlane = (Plane) hyperplane;
57	        final Plane thisPlane  = (Plane) getHyperplane();
58	        final Line  inter      = otherPlane.intersection(thisPlane);
59	
60	        if (inter == null) {
61	            // the hyperplanes are parallel,
62	            // any point can be used to check their relative position
63	            final double global = otherPlane.getOffset(thisPlane);
64	            return (global < -1.0e-10) ? Side.MINUS : ((global > 1.0e-10) ? Side.PLUS : Side.HYPER);
65	        }
66	
67	        // create a 2D line in the otherPlane canonical 2D frame such that:
68	        //   - the line is the crossing line of the two planes in 3D
69	        //   - the line splits the otherPlane in two half planes with an
70	        //     orientation consistent with the orientation of the instance
71	        //     (i.e. the 3D half space on the plus side (resp. minus side)
72	        //      of the instance contains the 2D half plane on the plus side
73	        //      (resp. minus side) of the 2D line
74	        Vector2D p = thisPlane.toSubSpace(inter.toSpace(Vector1D.ZERO));
75	        Vector2D q = thisPlane.toSubSpace(inter.toSpace(Vector1D.ONE));
76	        Vector3D crossP = Vector3D.crossProduct(inter.getDirection(), thisPlane.getNormal());
77	        if (crossP.dotProduct(otherPlane.getNormal()) < 0) {
78	            final Vector2D tmp = p;
79	            p           = q;
80	            q           = tmp;
81	        }
82	        final org.apache.commons.math3.geometry.euclidean.twod.Line line2D =
83	            new org.apache.commons.math3.geometry.euclidean.twod.Line(p, q);
84	
85	        // check the side on the 2D plane
86	        return getRemainingRegion().side(line2D);
