                    lines.add(new SubLine(proj[k], proj[(k + 1) % 3]));
                }
                Region<Euclidean2D> polyRegion = new PolygonsSet(lines);
                boundary.add(new SubPlane(polyPlane, polyRegion));
                facets++;
