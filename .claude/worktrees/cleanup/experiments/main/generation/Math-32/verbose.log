        boolean buggyIf = tx == 0 && ty == 0 && tz == 0 && perturbSteps == 0;

        assumeTrue(validIf);
        assumeTrue(buggyIf);

        double[] coords = {
            1, 2, 3,  1, 2, 5,  1, 4, 3,  1, 4, 5,
            3, 2, 3,  3, 2, 5,  3, 4, 3,  3, 4, 5
        };
        for (int i = 0; i < 8; i++) {
            coords[3 * i]     += tx;
            coords[3 * i + 1] += ty;
            coords[3 * i + 2] += tz;
        }
        coords[3 * 7 + 2] += 0.1 * perturbSteps;
        int[] indices = {
            0, 1, 2,  2, 1, 3,  4, 6, 5,  5, 6, 7,
            0, 4, 1,  1, 4, 5,  2, 3, 6,  6, 3, 7,
            0, 2, 4,  4, 2, 6,  1, 5, 3,  3, 5, 7
        };

