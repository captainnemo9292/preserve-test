251	                                array[j++] = null;
252	                                array[j++] = segment.getLine().toSpace(new Vector1D(x));
253	                            }
254	
255	                            if (j < (array.length - 1)) {
256	                                // current point
257	                                array[j++] = segment.getEnd();
258	                            }
259	
260	                            if (j == (array.length - 1)) {
261	                                // last dummy point
262	                                double x = segment.getLine().toSubSpace(segment.getStart()).getX();
263	                                x += FastMath.max(1.0, FastMath.abs(x / 2));
264	                                array[j++] = segment.getLine().toSpace(new Vector1D(x));
