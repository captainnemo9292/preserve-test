256	    /** Check a point with respect to the region starting at a given node.
257	     * @param node root node of the region
258	     * @param point point to check
259	     * @return a code representing the point status: either {@link
260	     * Region.Location#INSIDE INSIDE}, {@link Region.Location#OUTSIDE
261	     * OUTSIDE} or {@link Region.Location#BOUNDARY BOUNDARY}
262	     */
263	    protected Location checkPoint(final BSPTree<S> node, final Vector<S> point) {
264	        final BSPTree<S> cell = node.getCell(point);
265	        if (cell.getCut() == null) {
266	            // the point is in the interior of a cell, just check the attribute
267	            return ((Boolean) cell.getAttribute()) ? Location.INSIDE : Location.OUTSIDE;
268	        }
269	
270	        // the point is on a cut-sub-hyperplane, is it on a boundary ?
271	        final Location minusCode = checkPoint(cell.getMinus(), point);
272	        final Location plusCode  = checkPoint(cell.getPlus(),  point);
273	        return (minusCode == plusCode) ? minusCode : Location.BOUNDARY;
274	
275	    }
