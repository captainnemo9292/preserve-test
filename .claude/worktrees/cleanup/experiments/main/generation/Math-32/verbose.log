168	    /** Recursively build a tree by inserting cut sub-hyperplanes.
169	     * @param node current tree node (it is a leaf node at the beginning
170	     * of the call)
171	     * @param boundary collection of edges belonging to the cell defined
172	     * by the node
173	     */
174	    private void insertCuts(final BSPTree<S> node, final Collection<SubHyperplane<S>> boundary) {
175	
176	        final Iterator<SubHyperplane<S>> iterator = boundary.iterator();
177	
178	        // build the current level
179	        Hyperplane<S> inserted = null;
180	        while ((inserted == null) && iterator.hasNext()) {
181	            inserted = iterator.next().getHyperplane();
182	            if (!node.insertCut(inserted.copySelf())) {
183	                inserted = null;
184	            }
185	        }
186	
187	        if (!iterator.hasNext()) {
188	            return;
189	        }
190	
191	        // distribute the remaining edges in the two sub-trees
192	        final ArrayList<SubHyperplane<S>> plusList  = new ArrayList<SubHyperplane<S>>();
193	        final ArrayList<SubHyperplane<S>> minusList = new ArrayList<SubHyperplane<S>>();
194	        while (iterator.hasNext()) {
195	            final SubHyperplane<S> other = iterator.next();
196	            switch (other.side(inserted)) {
197	            case PLUS:
198	                plusList.add(other);
199	                break;
200	            case MINUS:
201	                minusList.add(other);
202	                break;
203	            case BOTH:
204	                final SubHyperplane.SplitSubHyperplane<S> split = other.split(inserted);
205	                plusList.add(split.getPlus());
206	                minusList.add(split.getMinus());
207	                break;
208	            default:
209	                // ignore the sub-hyperplanes belonging to the cut hyperplane
210	            }
211	        }
212	
213	        // recurse through lower levels
214	        insertCuts(node.getPlus(),  plusList);
215	        insertCuts(node.getMinus(), minusList);
216	
217	    }
