286	    /** Recursively build the boundary shell tree.
287	     * @param node current node in the inout tree
288	     */
289	    private void recurseBuildBoundary(final BSPTree<S> node) {
290	        if (node.getCut() != null) {
291	
292	            SubHyperplane<S> plusOutside = null;
293	            SubHyperplane<S> plusInside  = null;
294	
295	            // characterize the cut sub-hyperplane,
296	            // first with respect to the plus sub-tree
297	            final Characterization<S> plusChar = new Characterization<S>();
298	            characterize(node.getPlus(), node.getCut().copySelf(), plusChar);
299	
300	            if (plusChar.hasOut()) {
301	                // plusChar.getOut() corresponds to a subset of the cut
302	                // sub-hyperplane known to have outside cells on its plus
303	                // side, we want to check if parts of this subset do have
304	                // inside cells on their minus side
305	                final Characterization<S> minusChar = new Characterization<S>();
306	                characterize(node.getMinus(), plusChar.getOut(), minusChar);
307	                if (minusChar.hasIn()) {
308	                    plusOutside = minusChar.getIn();
309	                }
310	            }
311	
312	            if (plusChar.hasIn()) {
313	                // plusChar.getIn() corresponds to a subset of the cut
314	                // sub-hyperplane known to have inside cells on its plus
315	                // side, we want to check if parts of this subset do have
316	                // outside cells on their minus side
317	                final Characterization<S> minusChar = new Characterization<S>();
318	                characterize(node.getMinus(), plusChar.getIn(), minusChar);
319	                if (minusChar.hasOut()) {
320	                    plusInside = minusChar.getOut();
321	                }
322	            }
323	
324	            node.setAttribute(new BoundaryAttribute<S>(plusOutside, plusInside));
325	            recurseBuildBoundary(node.getPlus());
326	            recurseBuildBoundary(node.getMinus());
327	
328	        }
329	    }
