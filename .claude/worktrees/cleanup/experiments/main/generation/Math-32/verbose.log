331	    /** Filter the parts of an hyperplane belonging to the boundary.
332	     * <p>The filtering consist in splitting the specified
333	     * sub-hyperplane into several parts lying in inside and outside
334	     * cells of the tree. The principle is to call this method twice for
335	     * each cut sub-hyperplane in the tree, once one the plus node and
336	     * once on the minus node. The parts that have the same flag
337	     * (inside/inside or outside/outside) do not belong to the boundary
338	     * while parts that have different flags (inside/outside or
339	     * outside/inside) do belong to the boundary.</p>
340	     * @param node current BSP tree node
341	     * @param sub sub-hyperplane to characterize
342	     * @param characterization placeholder where to put the characterized parts
343	     */
344	    private void characterize(final BSPTree<S> node, final SubHyperplane<S> sub,
345	                              final Characterization<S> characterization) {
346	        if (node.getCut() == null) {
347	            // we have reached a leaf node
348	            final boolean inside = (Boolean) node.getAttribute();
349	            characterization.add(sub, inside);
350	        } else {
351	            final Hyperplane<S> hyperplane = node.getCut().getHyperplane();
352	            switch (sub.side(hyperplane)) {
353	            case PLUS:
354	                characterize(node.getPlus(), sub, characterization);
355	                break;
356	            case MINUS:
357	                characterize(node.getMinus(), sub, characterization);
358	                break;
359	            case BOTH:
360	                final SubHyperplane.SplitSubHyperplane<S> split = sub.split(hyperplane);
361	                characterize(node.getPlus(),  split.getPlus(),  characterization);
362	                characterize(node.getMinus(), split.getMinus(), characterization);
363	                break;
364	            default:
365	                // this should not happen
366	                throw new MathInternalError();
367	            }
368	        }
369	    }
