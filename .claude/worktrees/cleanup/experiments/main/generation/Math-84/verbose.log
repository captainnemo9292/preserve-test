27	/** 
28	 * This class implements the multi-directional direct search method.
29	 *
30	 * @version $Revision$ $Date$
31	 * @see NelderMead
32	 * @since 1.2
33	 */
34	public class MultiDirectional extends DirectSearchOptimizer {
35	
36	    /** Expansion coefficient. */
37	    private final double khi;
38	
39	    /** Contraction coefficient. */
40	    private final double gamma;
41	
42	    /** Build a multi-directional optimizer with default coefficients.
43	     * <p>The default values are 2.0 for khi and 0.5 for gamma.</p>
44	     */
45	    public MultiDirectional() {
46	        this.khi   = 2.0;
47	        this.gamma = 0.5;
48	    }
49	
50	    /** Build a multi-directional optimizer with specified coefficients.
51	     * @param khi expansion coefficient
52	     * @param gamma contraction coefficient
53	     */
54	    public MultiDirectional(final double khi, final double gamma) {
55	        this.khi   = khi;
56	        this.gamma = gamma;
57	    }
58	
59	    /** {@inheritDoc} */
60	    @Override
61	    protected void iterateSimplex(final Comparator<RealPointValuePair> comparator)
62	        throws FunctionEvaluationException, OptimizationException, IllegalArgumentException {
63	
64	        while (true) {
65	
66	            incrementIterationsCounter();
67	
68	            // save the original vertex
69	            final RealPointValuePair[] original = simplex;
70	            final RealPointValuePair best = original[0];
71	
72	            // perform a reflection step
73	            final RealPointValuePair reflected = evaluateNewSimplex(original, 1.0, comparator);
74	            if (comparator.compare(reflected, best) < 0) {
75	
76	                // compute the expanded simplex
77	                final RealPointValuePair[] reflectedSimplex = simplex;
78	                final RealPointValuePair expanded = evaluateNewSimplex(original, khi, comparator);
79	                if (comparator.compare(reflected, expanded) <= 0) {
80	                    // accept the reflected simplex
81	                    simplex = reflectedSimplex;
82	                }
83	
84	                return;
85	
86	            }
87	
88	            // compute the contracted simplex
89	            final RealPointValuePair contracted = evaluateNewSimplex(original, gamma, comparator);
90	            if (comparator.compare(contracted, best) < 0) {
91	                // accept the contracted simplex
92	
93	            // check convergence
94	                return;
95	            }
96	
97	        }
98	
99	    }
100	
101	    /** Compute and evaluate a new simplex.
102	     * @param original original simplex (to be preserved)
103	     * @param coeff linear coefficient
104	     * @param comparator comparator to use to sort simplex vertices from best to poorest
105	     * @return best point in the transformed simplex
106	     * @exception FunctionEvaluationException if the function cannot be evaluated at
107	     * some point
108	     * @exception OptimizationException if the maximal number of evaluations is exceeded
109	     */
110	    private RealPointValuePair evaluateNewSimplex(final RealPointValuePair[] original,
111	                                              final double coeff,
112	                                              final Comparator<RealPointValuePair> comparator)
113	        throws FunctionEvaluationException, OptimizationException {
114	
115	        final double[] xSmallest = original[0].getPointRef();
116	        final int n = xSmallest.length;
117	
118	        // create the linearly transformed simplex
119	        simplex = new RealPointValuePair[n + 1];
120	        simplex[0] = original[0];
121	        for (int i = 1; i <= n; ++i) {
122	            final double[] xOriginal    = original[i].getPointRef();
123	            final double[] xTransformed = new double[n];
124	            for (int j = 0; j < n; ++j) {
125	                xTransformed[j] = xSmallest[j] + coeff * (xSmallest[j] - xOriginal[j]);
126	            }
127	            simplex[i] = new RealPointValuePair(xTransformed, Double.NaN, false);
128	        }
129	
130	        // evaluate it
131	        evaluateSimplex(comparator);
132	        return simplex[0];
133	
134	    }
135	
136	}
