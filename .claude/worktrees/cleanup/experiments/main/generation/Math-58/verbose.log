        final double[] obs = new double[n];
        for (int i = 0; i < n; i++) {
            double d = i - p[1];
            obs[i] = p[0] * Math.exp(-d * d / (2 * p[2] * p[2]));
        }

        String exceptionName = "none";
        double[] result = null;
        try {
            GaussianFitter g = new GaussianFitter(new LevenbergMarquardtOptimizer());
            for (int i = 0; i < n; i++) {
                g.addObservedPoint(i, obs[i]);
